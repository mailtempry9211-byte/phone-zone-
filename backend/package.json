{
  "name": "phonezone-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PhoneZone local offline backend (Express + SQLite). No cloud dependency.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/init-cli.js",
    "test:offline": "node test/offline-suite.mjs"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "helmet": "^8.3.0",
    "jpeg-js": "^0.4.4",
    "multer": "^1.4.5-lts.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "unzipper": "^0.12.5"
  },
  "engines": {
    "node": "20.x"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "devDependencies": {
    "electron-rebuild": "^3.2.9"
  }
}
