{
  "manifest_version": 3,
  "name": "PhoneZone WhatsApp Dispatcher",
  "version": "1.0.0",
  "description": "Dispatches opt-in promotional messages from PhoneZone local server to WhatsApp Web safely and slowly.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhoneZone WhatsApp Dispatcher"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

