# PhoneZone environment template.
#
# Copy this file to `.env` and fill in the values for the mode you are running.
# Leave them EMPTY for the normal offline / EXE install - the local Express +
# SQLite backend needs none of them, and an empty file must never crash the app.
#
# NEVER commit the real `.env` (it is git-ignored) and never put real keys,
# passwords or tokens into a shared zip.

# --- Online / Supabase mode only (ignored in offline mode) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Optional local backend overrides (rarely needed) ---
# PHONEZONE_HOST=127.0.0.1
# PHONEZONE_PORT=47713
# PHONEZONE_DATA_DIR=
# PHONEZONE_SESSION_HOURS=12
# PHONEZONE_MAX_UPLOAD_BYTES=10485760

# Unattended installs may create the first admin without the setup wizard.
# Leave BOTH empty in normal use.
# PHONEZONE_ADMIN_EMAIL=
# PHONEZONE_ADMIN_PASSWORD=
